# Copy this file to .env and adjust as needed.

# --- Paths ---
DOCS_DIR=data/docs
CHROMA_DIR=data/chroma
COLLECTION_NAME=documents

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Embeddings (runs locally, free) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval ---
TOP_K=5

# --- LLM keys (needed from Day 4 onward) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
